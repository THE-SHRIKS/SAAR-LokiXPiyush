{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Strict offline permissions for SAAR desktop shell without network or updater capabilities",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "dialog:allow-open"
  ]
}
